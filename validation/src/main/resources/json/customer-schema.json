{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://mobileoperator.com/schema/customer-schema.json",
  "title": "Customer",
  "type": "object",
  "properties": {
    "id": {"$ref": "base.json#/definitions/idType"},
    "fullName": {"$ref": "base.json#/definitions/nameType"},
    "phoneNumber": {
      "type": "string",
      "minLength": 13,
      "maxLength": 13,
      "pattern": "^\\+380[0-9]{9}$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 50
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "tariffId": {"$ref": "base.json#/definitions/idType"},
    "isActive": {"type": "boolean"}
  },
  "required": ["id", "fullName", "phoneNumber", "createdAt", "tariffId", "isActive"],
  "additionalProperties": false
}