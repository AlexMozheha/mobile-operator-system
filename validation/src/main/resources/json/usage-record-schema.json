{"$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobileoperator.com/schema/usage-record.json",
  "title": "Record",
  "type": "object",
  "properties": {
    "customerId": {"$ref": "base.json#/definitions/idType"},
    "callMinutes": {"$ref": "base.json#/definitions/recordInt"},
    "smsCount": {"$ref": "base.json#/definitions/recordInt"},
    "internetCount": {"$ref": "base.json#/definitions/recordInt"},
    "usageDate": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "customerId", "callMinutes", "smsCount", "internetUsed", "usageDate"],
  "additionalProperties": false
}