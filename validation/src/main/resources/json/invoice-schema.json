{"$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobileoperator.com/schema/invoice.json",
  "title": "Invoice",
  "type": "object",
  "properties": {
    "id": {"$ref": "base.json#/definitions/uuidType"},
    "customerId": {"$ref": "base.json#/definitions/uuidType"},
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0.00,
      "multipleOf": 0.01,
      "maximum": 9999999999.99
    },
    "issueDate": {
      "type": "string",
      "format": "date-time"
    },
    "dueDate": {
      "type": "string",
      "format": "date-time"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PAID", "UNPAID", "OVERDUE", "CANCELLED"]
    }
  },
  "required": ["id","customerId","issueDate", "dueDate", "status"],
  "additionalProperties": false
}