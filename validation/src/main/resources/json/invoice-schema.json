{"$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobileoperator.com/schema/invoice-schema.json",
  "title": "Invoice",
  "type": "object",
  "properties": {
    "id": {"$ref": "base.json#/definitions/idType"},
    "customerId": {"$ref": "base.json#/definitions/idType"},
    "amount": {"$ref": "base.json#/definitions/moneyZIncType"},
    "issueDate": {
      "type": "string",
      "format": "date-time"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PAID", "UNPAID", "OVERDUE", "CANCELLED"]
    }
  },
  "required": ["customerId", "amount"],
  "additionalProperties": false
}