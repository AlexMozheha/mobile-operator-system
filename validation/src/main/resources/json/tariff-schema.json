{"$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobileoperator.com/schema/tariff.json",
  "title": "Tariff",
  "type": "object",
  "properties": {
    "id": {"$ref": "base.json#/definitions/idType"},
    "name": {"$ref": "base.json#/definitions/nameType"},
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "monthlyFee": {"$ref": "base.json#/definitions/moneyZIncType"},
    "internetLimit": {"$ref": "base.json#/definitions/recordInt"},
    "callMinutes": {"$ref": "base.json#/definitions/recordInt"},
    "smsLimit": {"$ref": "base.json#/definitions/recordInt"}
  },
  "required": ["id", "name", "monthlyFee", "callMinutes", "smsLimit"],
  "additionalProperties": false
}