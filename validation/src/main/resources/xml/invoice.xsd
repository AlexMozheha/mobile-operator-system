<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://mobileoperator.com/schema/invoice"
           targetNamespace="http://mobileoperator.com/schema/invoice"
           xmlns:base="http://mobileoperator.com/schema/base-types"
           elementFormDefault="qualified">

    <xs:import namespace="http://mobileoperator.com/schema/base-types" schemaLocation="base-types.xsd"/>

    <xs:element name="invoice" type="tns:InvoiceType"/>

    <xs:complexType name="InvoiceType">
        <xs:sequence>
            <xs:element name="id" type="base:idType" minOccurs="0"/>
            <xs:element name="customerId" type="base:idType"/>
            <xs:element name="amount" type="base:moneyZExType"/>
            <xs:element name="issueDate" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="paidAt" type="xs:dateTime" minOccurs="0"/>
            <xs:element name="status" type="tns:InvoiceStatusType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="InvoiceStatusType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PAID"/>
            <xs:enumeration value="UNPAID"/>
            <xs:enumeration value="OVERDUE"/>
            <xs:enumeration value="CANCELLED"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>